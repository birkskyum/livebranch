// The app is a Worker that serves the static build from dist. Only /api/* runs the script
// (worker/index.ts), which is the engine behind an HTTP API.
{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "livebranch",
    "account_id": "6cdb092c9ea997e1cbe7d46d42527d5c",
    "compatibility_date": "2026-09-25",
    "main": "./worker/index.ts",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api", "/api/*"],
    },
    // The app has one address. Links and the previews that a browser keeps belong to it.
    "routes": [{"pattern": "livebranch.dev", "custom_domain": true}],
    "workers_dev": false,
    // At most 30 requests a minute to the API from one address.
    "ratelimits": [
        {"name": "API_LIMIT", "namespace_id": "1002", "simple": {"limit": 30, "period": 60}},
        // The GitHub reader is asked up to four times per opened link and its answers are cached.
        {"name": "GITHUB_LIMIT", "namespace_id": "1003", "simple": {"limit": 300, "period": 60}},
    ],
    // A Worker may not compile WebAssembly from bytes, which the default build of the lexer does.
    "alias": {"es-module-lexer": "es-module-lexer/js"},
}
