// The app is a Worker that serves the static build from dist, and the engine behind an HTTP API
// (worker/index.ts). Each link's previews run on a host of its own, p-<hash>.livebranch.dev.
{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "livebranch",
    "account_id": "6cdb092c9ea997e1cbe7d46d42527d5c",
    "compatibility_date": "2026-09-25",
    "main": "./worker/index.ts",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        // A link's host serves only the service worker and the runtime, so every request asks the script.
        "run_worker_first": true,
    },
    // The app has one address. The hosts of links need a DNS record for *.livebranch.dev, which
    // Universal SSL covers, as it covers only one level.
    "routes": [
        {"pattern": "livebranch.dev", "custom_domain": true},
        {"pattern": "*.livebranch.dev/*", "zone_name": "livebranch.dev"},
    ],
    "workers_dev": false,
    // At most 30 requests a minute to the API from one address.
    "ratelimits": [
        {"name": "API_LIMIT", "namespace_id": "1002", "simple": {"limit": 30, "period": 60}},
        // The GitHub reader is asked up to four times per opened link and its answers are cached.
        {"name": "GITHUB_LIMIT", "namespace_id": "1003", "simple": {"limit": 300, "period": 60}},
    ],
    // Pictures of pull requests that GitHub Actions workflows post (worker/pictures.ts), and the
    // accounts whose repositories may store them.
    "r2_buckets": [{"binding": "PICTURES", "bucket_name": "livebranch-pictures"}],
    "vars": {"PICTURE_OWNERS": "maplibre,birkskyum"},
    // A check within the API's source budget takes a few seconds.
    "limits": {"cpu_ms": 15000},
    // A Worker may not compile WebAssembly from bytes, which the default build of the lexer does.
    "alias": {"es-module-lexer": "es-module-lexer/js"},
}
