{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": [
            "es2023",
            "dom",
            "dom.iterable"
        ],
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "types": [
            "vite/client",
            "node"
        ]
    },
    "include": [
        "src",
        "bin",
        "worker",
        "vite.config.ts"
    ]
}
